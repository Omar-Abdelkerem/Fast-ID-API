  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
}

enum email_template {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  CREDENTIAL_REVOKED
  DELIVERY_OUT_FOR_DELIVERY
  DELIVERY_FAILED_ATTEMPT
  DELIVERY_COMPLETED
  PASSWORD_RESET
  PASSWORD_CHANGED
