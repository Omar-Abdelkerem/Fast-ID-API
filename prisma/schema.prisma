}

enum notification_entity {
  APPLICATION
  DELIVERY
}

enum notification_type {
  APPLICATION_SUBMITTED
  APPLICATION_CANCELLED
  APPLICATION_UNDER_REVIEW
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  CREDENTIAL_REVOKED
  DELIVERY_ASSIGNED
  DELIVERY_OUT_FOR_DELIVERY
