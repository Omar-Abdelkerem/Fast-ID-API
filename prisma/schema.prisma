  APPLICATION_SUBMITTED
  APPLICATION_REVIEW_STARTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_CANCELLED
  CREDENTIAL_ISSUED
  CREDENTIAL_REVOKED
  DELIVERY_CREATED
  DELIVERY_ASSIGNED
  DELIVERY_OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERY_COMPLETED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_PUBLISHED
  SERVICE_UNPUBLISHED
  SERVICE_DELETED
  STAFF_CREATED
  STAFF_UPDATED
  CITIZEN_DEACTIVATED
  CITIZEN_REACTIVATED
  PAYMENT_MARKED_PAID_MOCK
  PASSWORD_RESET_COMPLETED
  SETTINGS_UPDATED
