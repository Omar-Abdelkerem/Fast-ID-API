# Copy this file to .env and fill in values for your environment.
# Never commit .env or real secrets to version control.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL (matches docker-compose.yml defaults when running locally)
POSTGRES_USER=fastid
POSTGRES_PASSWORD=replace_with_local_db_password
POSTGRES_DB=fastid
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fastid:replace_with_local_db_password@127.0.0.1:5432/fastid?schema=public

# Auth & cookies (JWT_SECRET must be at least 32 random bytes)
JWT_SECRET=replace_with_at_least_32_random_characters_secret
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS & frontend base URL (exact origins, comma-separated, never *)
CORS_ORIGINS=http://127.0.0.1:5173
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Email (EMAIL_DRIVER=log in dev; EMAIL_DRIVER=resend requires API key and EMAIL_FROM)
EMAIL_DRIVER=log
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# File storage (STORAGE_DRIVER=local | cloudinary | s3; local path must be outside any web root)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=fast-id
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# Payment mode (mock | disabled)
PAYMENT_MODE=mock

# First-boot admin bootstrap (optional after at least one ADMIN exists in the database)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
